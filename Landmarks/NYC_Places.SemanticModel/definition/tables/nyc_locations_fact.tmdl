				  #"Replaced value 1" = Table.ReplaceValue(#"Replaced value", "MN", "Manhattan", Replacer.ReplaceText, {"Borough"}),
				  #"Replaced value 2" = Table.ReplaceValue(#"Replaced value 1", "QN", "Queens", Replacer.ReplaceText, {"Borough"}),
				  #"Replaced value 3" = Table.ReplaceValue(#"Replaced value 2", "BX", "Bronx", Replacer.ReplaceText, {"Borough"}),
				  #"Replaced value 4" = Table.ReplaceValue(#"Replaced value 3", "SI", "Staten Island", Replacer.ReplaceText, {"Borough"}),
				  #"Inserted conditional column 1" = Table.AddColumn(#"Replaced value 4", "Custom", each if [confidence] = "low" then null else [wiki_url])
				in
				  #"Inserted conditional column 1"

	annotation PBI_NavigationStepName = Navigation

