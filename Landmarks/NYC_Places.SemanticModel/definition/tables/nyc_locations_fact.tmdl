table nyc_locations_fact
	lineageTag: 069acf4a-9b42-4ca8-98ef-83e2e863a067

	measure 'Selected Location' =
			
			VAR _Hood = SELECTEDVALUE ( 'nyc_locations_fact'[NTAName] )
			VAR _Boro = SELECTEDVALUE ( 'nyc_locations_fact'[Borough] )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _Hood ), _Hood,
			        NOT ISBLANK ( _Boro ), _Boro,
			        "Multiple"
			    )
		lineageTag: fc0439cf-f6ba-42b7-9577-c76d4a0dcd5b

	measure Location_Count = DISTINCTCOUNT(nyc_locations_fact[loc_id])
		formatString: 0
		lineageTag: e20d8564-437f-48a5-a704-0487a96ba775

	measure Location_Count_All =
			
			CALCULATE(
			    [Location_Count],
			    ALL(nyc_locations_fact))
		formatString: 0
		lineageTag: 87b8e573-64cb-4f36-bf2b-0beaa7a3b110

	measure '% Locations' = DIVIDE([Location_Count], [Location_Count_All],0)
		lineageTag: e0da925c-9bc7-41ed-b82a-cfa1eac7f4b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Excluded_Location_Count = [Location_Count_All] - [Location_Count]
		formatString: 0
		lineageTag: 53b569fb-5b7e-4c38-8167-fa9e07ff693a

